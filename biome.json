{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "root": "."
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/.next",
            "!**/dist",
            "!**/bun.lock",
            "!**/next-env.d.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "linter": { "enabled": false },
    "assist": { "enabled": false },
    "css": { "parser": { "tailwindDirectives": true } },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single",
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded"
        }
    }
}
